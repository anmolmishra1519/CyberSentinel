# Copy this file to `.env` (or export these as real environment variables)
# before running the Spring Boot backend. Never commit a real .env file.

# MongoDB connection string. Use a strong username/password in production;
# for local development the default local MongoDB instance is fine.
MONGODB_URI=mongodb://localhost:27017/cybersentinel

# Base URL of the Python FastAPI ML service
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_SECONDS=8

# Frontend origin allowed to call this API (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173
